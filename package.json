{
  "name": "wordpress-theme",
  "description": "Modern starter kit with Vite, Tailwind CSS v4, Alpine.js and TypeScript. WordPress theme starter template.",
  "packageManager": "pnpm@11.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "host": "vite --host",
    "build": "tsc --noEmit && vite build && bash scripts/package-theme.sh",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "check": "pnpm lint && pnpm format:check && pnpm build",
    "package": "pnpm build"
  },
  "devDependencies": {
    "@alpinejs/collapse": "^3.15.12",
    "@alpinejs/focus": "^3.15.12",
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-php": "^0.24.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "@types/alpinejs": "^3.13.11",
    "alpinejs": "^3.15.12",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vite-plugin-full-reload": "^1.2.0"
  },
  "dependencies": {
    "lenis": "^1.3.25",
    "swiper": "^12.2.0",
    "taos": "^2.0.1"
  }
}
