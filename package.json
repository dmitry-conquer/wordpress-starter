{
  "name": "site-theme",
  "description": "Custom WordPress theme with Vite, Tailwind CSS v4, Alpine.js and TypeScript.",
  "packageManager": "pnpm@11.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "host": "vite --host",
    "build": "tsc --noEmit && vite build && node scripts/package-theme.mjs",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "check": "pnpm lint && pnpm format:check && pnpm build",
    "package": "pnpm build"
  },
  "devDependencies": {
    "@alpinejs/collapse": "^3.15.12",
    "@alpinejs/focus": "^3.15.12",
    "@eslint/js": "^10.0.1",
    "@prettier/plugin-php": "^0.24.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/alpinejs": "^3.13.11",
    "@types/alpinejs__collapse": "^3.13.4",
    "@types/alpinejs__focus": "^3.13.4",
    "alpinejs": "^3.15.12",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-full-reload": "^1.2.0"
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "taos": "^2.0.1"
  }
}
